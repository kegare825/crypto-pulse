# Local environment files (may hold real credentials) — never commit.
# Templates .env.example / .env.demo contain demo values only and stay tracked.
.env
**/.env
.env.local
.env.*.local
!.env.example
!.env.demo
.venv/
__pycache__/
*.py[cod]
.venv/
venv/
ingest/.venv/
.pytest_cache/
*.egg-info/
dbt/target/
dbt/dbt_packages/
docs/dbt/

# Terraform (local state; lock file is committed)
.terraform/
*.tfstate
*.tfstate.*
.terraform.tfstate.lock.info
crash.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
